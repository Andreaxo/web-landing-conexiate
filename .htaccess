RewriteEngine On

############################################
# 1. FORZAR HTTPS
############################################
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

############################################
# 2. FORZAR SIN WWW
############################################
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

############################################
# 3. REDIRIGIR / → /principal
############################################
RewriteRule ^$ principal [L,R=301]

############################################
# 4. QUE /principal CARGUE index.html
############################################
RewriteRule ^principal/?$ index.html [L]

############################################
# 5. QUITAR .html DE TODAS LAS URL
############################################
# Si el archivo .html existe, permite acceder SIN poner .html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

############################################
# 6. REDIRECCIÓN LIMPIA SI USAN .html MANUALMENTE
############################################
RewriteCond %{THE_REQUEST} (.*)\.html[\? ] [NC]
RewriteRule ^(.+)\.html$ /$1 [L,R=301]

############################################
# 7. BLOQUEAR LISTADO DE DIRECTORIOS
############################################
Options -Indexes
